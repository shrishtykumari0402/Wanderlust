<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <h3>Edit your Listing</h3>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT"
            novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <lable for="title" class="form-label">Title</lable>
                <input name="listing[title]" value="<%= listing.title %>"
                    type="text"
                    class="form-control" required />
                <div class="valid-feedback">
                    title looks good!
                </div>
            </div>
            <div class="mb-3">
                <lable for="description" class="form-label">Description</lable>
                <textarea name="listing[description]" class="form-control"
                    required><%= listing.description %></textarea>
                <div class="invalid-feedback">
                    Please enter a short description
                </div>
                <div class="mb-3">
                    Original Listing Image <br />
                    <img src="<%= originalImageurl %>" />
                </div>
            </div>
            <div class="mb-3">
                <lable for="image" class="form-label">Upload New Image</lable>
                <input name="listing[image]" type="file" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select name="listing[category]" id="category" class="form-select" required>
                    <option value="views" <%= listing.category === "views" ? "selected" : "" %>>Amazing views</option>
                    <option value="beachfront" <%= listing.category === "beachfront" ? "selected" : "" %>>Beachfront</option>
                    <option value="creative-spaces" <%= listing.category === "creative-spaces" ? "selected" : "" %>>Creative spaces</option>
                    <option value="pools" <%= listing.category === "pools" ? "selected" : "" %>>Amazing pools</option>
                    <option value="popular" <%= listing.category === "popular" || !listing.category ? "selected" : "" %>>Popular</option>
                    <option value="nature" <%= listing.category === "nature" ? "selected" : "" %>>Nature</option>
                    <option value="snowy-escapes" <%= listing.category === "snowy-escapes" ? "selected" : "" %>>Snowy escapes</option>
                    <option value="tropical" <%= listing.category === "tropical" ? "selected" : "" %>>Tropical</option>
                    <option value="luxury" <%= listing.category === "luxury" ? "selected" : "" %>>Luxury</option>
                    <option value="pet-friendly" <%= listing.category === "pet-friendly" ? "selected" : "" %>>Pet-friendly</option>
                </select>
            </div>

            <div class="row">

                <div class="mb-3 col-md-4">
                    <lable class="form-label">Price</lable>
                    <input name="listing[price]"
                        value="<%= listing.price %>"
                        class="form-control" required>
                    <div class="invalid-feedback">
                        Please enter a valid Price!
                    </div>
                </div>

                <div class="mb-3 col-md-8">
                    <lable class="form-label">Country</lable>
                    <input name="listing[country]"
                        value="<%= listing.country %>"
                        class="form-control" required>
                    <div class="invalid-feedback">
                        Please enter a Country name
                    </div>
                </div>

            </div>

            <div class="mb-3">
                <lable for="location" class="form-label">Location</lable>
                <input
                    name="listing[location]"
                    value="<%= listing.location %>"
                    type="text" class="form-control" required />
                <div class="invalid-feedback">
                    Please enter a Location name
                </div>
            </div>

            <br /><br />
            <button class="btn btn-dark edit-btn">Edit</button>
        </form>
    </div>
</div>
