<% layout("/layouts/boilerplate") %>
<style>
    #filters {
        display: flex;
        gap: 1.75rem;
        overflow-x: auto;
        padding: 0.75rem 0 0.5rem;
        border-bottom: 1px solid #eeeeee;
        scrollbar-width: none;
    }

    #filters::-webkit-scrollbar {
        display: none;
    }

    .filter {
        flex: 0 0 auto;
        text-align: center;
        min-width: 4.5rem;
        padding: 0.5rem 0.1rem 0.65rem;
        opacity: 0.7;
        border-bottom: 2px solid transparent;
        transition: opacity 0.2s ease, border-color 0.2s ease;
        color: #222222;
        text-decoration: none;
    }

    .filter i {
        font-size: 0.8rem;
    }

    .filter p {
        margin: 0.45rem 0 0;
        font-size: 0.6rem;
        white-space: nowrap;
    }

    .filter:hover {
        opacity:1;
        cursor:pointer;
        border-color: #222222;
    }

    .filter.active {
        opacity: 1;
        border-color: #222222;
    }

    .tax-toggle {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        margin-left: auto;
        padding-left: 0.8rem;
        border-left: 1px solid #dddddd;
        white-space: nowrap;
    }

    .tax-toggle .form-check {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-height: auto;
        margin: 0;
        padding: 0;
    }

    .tax-toggle .form-check-input {
        float: none;
        width: 2.5rem;
        height: 1.5rem;
        margin: 0;
        border-color: #999999;
        cursor: pointer;
    }

    .tax-toggle .form-check-input:checked {
        background-color: #222222;
        border-color: #222222;
    }

    .tax-toggle .form-check-label {
        color: #222222;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .tax-info {
        display: none;
    }

    @media (max-width: 768px) {
        .tax-toggle {
            margin-left: 0;
            padding-left: 1rem;
        }
    }
</style>
<div id="filters">
    <a href="/listings?category=views"
        class="filter <%= selectedCategory === 'views' ? 'active' : '' %>">
        <div><i class="fa-solid fa-house-chimney-window"></i></div>
        <p>Views</p>
    </a>
    <a href="/listings?category=beachfront"
        class="filter <%= selectedCategory === 'beachfront' ? 'active' : '' %>">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Beachfront</p>
    </a>
    <a href="/listings?category=creative-spaces"
        class="filter <%= selectedCategory === 'creative-spaces' ? 'active' : '' %>">
        <div><i class="fa-solid fa-pen-ruler"></i></div>
        <p>Creative spaces</p>
    </a>
    <a href="/listings?category=pools"
        class="filter <%= selectedCategory === 'pools' ? 'active' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pools</p>
    </a>
    <a href="/listings?category=popular"
        class="filter <%= selectedCategory === 'popular' ? 'active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Popular</p>
    </a>
    <a href="/listings?category=nature"
        class="filter <%= selectedCategory === 'nature' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Nature</p>
    </a>
    <a href="/listings?category=snowy-escapes"
        class="filter <%= selectedCategory === 'snowy-escapes' ? 'active' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Snowy escapes</p>
    </a>
    <a href="/listings?category=tropical"
        class="filter <%= selectedCategory === 'tropical' ? 'active' : '' %>">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Tropical</p>
    </a>
    <a href="/listings?category=luxury"
        class="filter <%= selectedCategory === 'luxury' ? 'active' : '' %>">
        <div><i class="fa-solid fa-gem"></i></div>
        <p>Luxury</p>
    </a>
    <a href="/listings?category=pet-friendly"
        class="filter <%= selectedCategory === 'pet-friendly' ? 'active' : '' %>">
        <div><i class="fa-solid fa-paw"></i></div>
        <p>Pet-friendly</p>
    </a>
    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch"
                id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display
                total after taxes</label>
        </div>
    </div>

</div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
            <img
                src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6' %>"
                class="card-img-top"
                alt="listing_image"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=900&q=80';"
                style="height:20rem" />
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b> <br>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                    <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                </p>
            </div>
        </div>
    </a>
    <% } %>

</div>

<script>
let taxSwitch = document.getElementById("switchCheckDefault");
taxSwitch.addEventListener("click", () => {
let taxInfo = document.getElementsByClassName("tax-info");
for (let info of taxInfo) {
if(info.style.display != "inline") {
info.style.display = "inline";
} else {
info.style.display = "none";
}
 }
});
</script>