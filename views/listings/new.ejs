<% layout("/layouts/boilerplate") %>
<div class="row">
  <div class="col-8 offset-2">
    <!-- <br/><br/> -->
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      <div class=" mb-3">
        <lable for="title" class="form-label">Title</lable>
        <input name="listing[title]" placeholder="Add a catchy title"
          type="text"
          class="form-control" required />
          <div class="valid-feedback">
            title looks good!
          </div>
      </div>
      <div class="mb-3">
        <lable for="description" class="form-label">Description</lable>
        <textarea
          name="listing[description]"
          class="form-control" required ></textarea>
          <div class="invalid-feedback">
           Please enter a short description
          </div>
      </div>

      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select name="listing[category]" id="category" class="form-select" required>
          <option value="" selected disabled>Choose a category</option>
          <option value="views">Amazing views</option>
          <option value="beachfront">Beachfront</option>
          <option value="creative-spaces">Creative spaces</option>
          <option value="pools">Amazing pools</option>
          <option value="popular">Popular</option>
          <option value="nature">Nature</option>
          <option value="snowy-escapes">Snowy escapes</option>
          <option value="tropical">Tropical</option>
          <option value="luxury">Luxury</option>
          <option value="pet-friendly">Pet-friendly</option>
        </select>
      </div>

  
      <div class="mb-3">
        <lable for="image" class="form-label">Upload Listing Image</lable>
        <input
          name="listing[image]"
          type="file" class="form-control" />
          required
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <lable for="price" class="form-label">Price</lable>
          <input name="listing[price]" placeholder="1200" 
            class="form-control" required />
            <div class="invalid-feedback">
            Please enter a valid Price!
          </div>
        </div>
        <div class="mb-3 col-md-8 ">
          <lable for="Country" class="form-label">Country</lable>
          <input name="listing[country]" placeholder="India" type="text"
            class="form-control" required />
            <div class="invalid-feedback">
           Please enter a Country name
          </div>
        </div>
      </div>

      <div class="mb-3">
        <lable for="Location" class="form-label">Location</lable>
        <input
          name="listing[location]"
          placeholder="Jaipur, Rajasthan"
          type="text"
          class="form-control" required />
          <div class="invalid-feedback">
            Please enter a Location name
          </div>
      </div>

      <br /><br />
      <button class="btn btn-dark add-btn">Add</button>
      <br /><br />
    </form>
  </div>
</div>